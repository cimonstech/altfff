# Copy this file to .env.local and fill in real values from the Supabase
# project dashboard (Project Settings -> API). Never commit .env or
# .env.local - only this .env.example template is tracked in git.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only - NEVER expose this to the browser or use it in a client
# component. Bypasses Row Level Security entirely. Used exclusively by
# server-only code (Route Handlers) for the admin-invite operation and any
# future backend job that deliberately needs to bypass RLS (e.g. the
# bulk-communication queue in a later phase).
#
#qstash - hello@motivo
#r2 bucket - cimonstech

SUPABASE_SERVICE_ROLE_KEY=

# Resend - used by every form-submission Route Handler that sends a
# confirmation email (exhibitor-applications, sponsor-inquiries,
# visitor-registrations, contact).
RESEND_API_KEY=

# The "from" address for those emails. Must be on a domain verified in the
# Resend account tied to RESEND_API_KEY above, otherwise sends fail with a
# 403 (domain not verified) even though the API key itself is valid. No
# fallback is hardcoded in the routes - if this isn't set, email sending is
# skipped and logged server-side rather than crashing the request.
RESEND_FROM_EMAIL=

# Cloudflare R2 (S3-compatible object storage) - used for admin-uploaded
# images (news post cover images, in-editor images). Uploads go browser ->
# R2 directly via presigned URLs; the Next.js server only ever issues the
# presigned URL, it never receives the raw file bytes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL objects are served from (a custom domain or the bucket's
# r2.dev URL) - object keys are appended to this directly, no trailing slash.
R2_PUBLIC_URL=

# Fish Africa SMS (letsfish.africa) - used by src/lib/sms.ts for the admin
# Communications tab's SMS channel. TEMPORARY: these are borrowed
# AgroTalentHub credentials/sender ID for build and testing. Replace with
# Alt.FFF's own registered credentials in the environment once available,
# no code change needed when that happens.
FISH_AFRICA_APP_ID=
FISH_AFRICA_APP_SECRET=
FISH_AFRICA_SENDER_ID=

# Upstash QStash - queues per-recipient jobs for bulk communications (see
# src/lib/qstash.ts and app/api/admin/communications/process-recipient).
# Shared existing Upstash account - same one used elsewhere in this org.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Absolute base URL of this deployment - QStash needs a real, publicly
# reachable URL to call back to for queued jobs, it cannot reach
# http://localhost:3000. Set to https://www.altfff.com in production; the
# fallback below is for local dev only and means bulk (queued) sends cannot
# be fully tested from localhost - use a real deployed preview URL for that.
SITE_URL=http://localhost:3000

# Upstash Redis - per-IP rate limiting on the four public form routes
# (see src/lib/rateLimit.ts). Create a Redis database in the same Upstash
# account used for QStash; REST URL + token appear right after creation.
# If unset, rate limiting fails open (submissions still work; a warning is
# logged server-side).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error monitoring (@sentry/nextjs). The DSN is safe to expose
# client-side - that's how the browser SDK is designed. Create an Alt.FFF
# project at sentry.io (or reuse an existing org) and paste the DSN here.
# Runtime reporting is production-only unless you also set the enable-dev
# flags below for a deliberate local verify session.
NEXT_PUBLIC_SENTRY_DSN=

# Optional: force Sentry on in local/dev for a verify pass (off by default
# so hot-reload and localhost QStash/rate-limit gaps don't flood the project).
# SENTRY_ENABLE_DEV=true
# NEXT_PUBLIC_SENTRY_ENABLE_DEV=true

# Optional CI-only: source map upload for readable production stack traces.
# Never required for runtime error capture - only for prettier stacks.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
